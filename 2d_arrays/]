#include<stdio.h>
#include<stdlib.h>
void sprial(int *arr[4])
{
	int top=0,bottom=4,end=3,f=0;
	while(top<bottom)
	{
		
		bottom--;
		for(int i=top;i<=end;i++)
		{
		     printf("%d ",*(*(arr+i)+top));
		}
		top++;
		for(int i=top;i<=end;i++)
		{
                    printf("%d ",*(*(arr+end)+top));
		}
		end--;
		for(int i=end;i>=f;i--)
		{
			printf("%d ",*(*(arr+end)+bottom));
		}
		bottom--;
		for(int i=bottom;i>f;i--)
		{
			printf("%d ",*(*(arr+f)+bottom));
		}
		f++;
	}
}
int main()
{
     int  arr[4][4];
     for(int i=0;i<4;i++)
	    {
		    for(int j=0;j<4;j++)
		    {
			    scanf("%d",&arr[i][j]);
		    }
	    }
     sprial(arr);
}
